# --- Core ---
NODE_ENV=development
PORT=4400
WEB_PORT=3001

# --- Network (mainnet | testnet) ---
# Mainnet is the default. Switching to testnet uses devnet/Sepolia RPC endpoints
# and unlocks the wallet faucet. Mainnet REQUIRES a real AWS_KMS_KEY_ID below —
# the API will refuse to boot otherwise, UNLESS you set ALLOW_UNSAFE_LOCAL_KMS=1
# (solo-dev escape hatch — see below).
NETWORK_MODE=mainnet

# Solo-dev escape hatch. Set ONLY when you understand the risk:
# with this flag, mainnet wallet keys are encrypted with a key derived from
# JWT_SECRET. If JWT_SECRET ever leaks, every wallet on this server is
# decryptable. NEVER set this in production. Throwaway / test wallets only.
# ALLOW_UNSAFE_LOCAL_KMS=1

# --- Database ---
DATABASE_URL=postgresql://qwai:qwai@localhost:5432/qwai
REDIS_URL=redis://localhost:6379

# --- Auth ---
JWT_SECRET=replace-me-32-bytes-min
JWT_EXPIRES_IN=15m
REFRESH_EXPIRES_IN=7d

# --- AWS KMS (envelope encryption for wallet keys) ---
AWS_REGION=us-east-1
AWS_KMS_KEY_ID=alias/qwai-wallet
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- LLM (powers AI reasoning on every token scan) ---
# ➜ Get at: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
# ➜ Get at: https://platform.openai.com/api-keys (alternative to Anthropic)
OPENAI_API_KEY=
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-6
LLM_FALLBACK_MODEL=gpt-4o
LLM_TIMEOUT_MS=30000

# --- Hot Token Scanner ---
# HOT_TOKENS_ENABLED=true          — set to 'false' to disable the scanner entirely
# HOT_TOKENS_FAST_SCAN=false       — set to 'true' for 10-sec price refresh (more DexScreener calls)
# HOT_SCAN_INTERVAL_MS=20000       — full scan interval in ms (default 20s; min safe ~15s)
HOT_TOKENS_ENABLED=true
HOT_TOKENS_FAST_SCAN=false
HOT_SCAN_INTERVAL_MS=20000

# ════════════════════════════════════════════════════════════════════════════════
# TOKEN INTELLIGENCE PROVIDERS
# Each section: what it enables → how to get the key → leave blank to disable
# ════════════════════════════════════════════════════════════════════════════════

# --- Helius (REQUIRED for Solana RPC + holder metrics) ---
# What: Solana RPC, top-10 holder concentration, parsed transactions
# Get:  https://dev.helius.xyz → Sign up free → Dashboard → Copy RPC URL
# Free: 10 RPS. Paid: $49/mo for 100 RPS
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# --- Solana Tracker (top-100 holders, risk score, pump.fun lifecycle) ---
# What: Top-100 holder concentration (vs Helius top-10 only), rug risk score,
#       pump.fun bonding curve %, graduation status, lifecycle stage
# Get:  https://www.solanatracker.io → Sign up → Profile → API Key
# Free: Limited req/min. Paid tier available
SOLANA_TRACKER_API_KEY=

# --- Moralis (pump.fun lifecycle + EVM holders) ---
# What: pump.fun bonding curve progress, graduation status, EVM token holder lists
# Get:  https://moralis.io → Sign up free → Web3 APIs → API Key
# Free: 25 req/sec. Paid: $49/mo
MORALIS_API_KEY=

# --- Birdeye (price impact simulation) ---
# What: $500/$1K/$5K buy price impact simulation — tells you real exit cost
#       Also: unique trader count, volume quality signals
# Get:  https://birdeye.so → Sign up → API → Create Key (free tier available)
# Free: 10 req/min. Paid tiers available
BIRDEYE_API_KEY=

# --- Etherscan (EVM top-holder lists) ---
# What: Top-20 token holders for Ethereum, Base, BSC, Arbitrum, Optimism, Polygon
#       Used to compute top-10 concentration for EVM tokens
# Get:  https://etherscan.io → Sign In → API Keys → Add (free)
#       For Base: https://basescan.org → same process (separate free key)
# Free: 5 req/sec. No cost for basic tier
ETHERSCAN_API_KEY=

# --- Bitquery (bundle detection fallback + pump.fun trade patterns) ---
# What: Programmatic Jito bundle detection via GraphQL (fallback when BundleChecker unavailable)
#       Also: pump.fun trade history, top traders, ATH calculation
# Get:  https://bitquery.io → Sign up → Account → API Key
# Free: 10,000 points/month (~333 calls). Use sparingly — gated to high-value scans
BITQUERY_API_KEY=

# --- Telegram Bot (community health check) ---
# What: Telegram group member count — used to assess community size and health
# Get:  Talk to @BotFather on Telegram → /newbot → copy the token
#       Then add your bot to the token's Telegram group as a member
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=
# Set TELEGRAM_BOT_POLL=1 for local dev (no public URL required).
# In production, leave blank — TELEGRAM_WEBHOOK_URL is used instead.
TELEGRAM_BOT_POLL=1
# Public web URL — used in Telegram magic links and scan deep-links. No trailing slash.
APP_WEB_URL=https://app.qwai.io
# gramjs userbot — get both from https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# --- Chains & RPC ---
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
JUPITER_API_BASE=https://lite-api.jup.ag/swap/v1
JITO_BUNDLE_URL=https://mainnet.block-engine.jito.wtf
ETH_RPC_URL=
ARBITRUM_RPC_URL=
BASE_RPC_URL=
ONEINCH_API_KEY=

# ════════════════════════════════════════════════════════════════════════════════
# PROVIDERS WITH NO KEY REQUIRED (free, auto-enabled)
# ════════════════════════════════════════════════════════════════════════════════
# The following providers activate automatically — no env var needed:
#   DexScreener     — market data, socials, pair age
#   GeckoTerminal   — supplemental market data
#   GoPlus Security — EVM safety (30+ flags: honeypot, tax, proxy, etc.)
#   RugCheck        — Solana safety (risk score, mint/freeze authority)
#   Jupiter API     — Solana organic score, token verification status
#   DeFiLlama       — Chain TVL trend (macro context)
#   RDAP.org        — Domain registration date (website age)
#   Wayback Machine — Website history change detection
#   BundleChecker   — Jito bundle detection (trench.bot, no key)
#   GMGN            — Smart money wallet detection (scraper, no key)
#   Arkham          — Entity labeling for flagged wallets (free tier)

# ════════════════════════════════════════════════════════════════════════════════
# INTEL CACHE TUNING
# ════════════════════════════════════════════════════════════════════════════════
# In-memory cache TTL (seconds). Lower = fresher data, more provider calls.
INTEL_CACHE_TTL_SEC=60
# DB cache TTL (seconds). Reports older than this trigger a re-analysis.
INTEL_DB_CACHE_TTL_SEC=120

# ════════════════════════════════════════════════════════════════════════════════
# LEGACY / UNUSED SLOTS (kept for compatibility)
# ════════════════════════════════════════════════════════════════════════════════
COINGECKO_API_KEY=
GOPLUS_API_KEY=
RUGCHECK_API_KEY=
X_BEARER_TOKEN=            # X/Twitter Basic API ($100/mo) — not wired yet
GMGN_APIFY_KEY=            # Apify GMGN scraper — not wired (direct scrape used instead)

# --- AWS KMS ---
AWS_REGION=us-east-1
AWS_KMS_KEY_ID=alias/qwai-wallet
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Observability ---
DATADOG_API_KEY=
SENTRY_DSN=

# --- Web ---
NEXT_PUBLIC_API_BASE=http://localhost:4400
NEXT_PUBLIC_WS_BASE=ws://localhost:4400
