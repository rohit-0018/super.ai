# --- Core ---
NODE_ENV=development
PORT=4400
WEB_PORT=3001

# --- Network (mainnet | testnet) ---
# Mainnet is the default. Switching to testnet uses devnet/Sepolia RPC endpoints
# and unlocks the wallet faucet. Mainnet REQUIRES a real AWS_KMS_KEY_ID below —
# the API will refuse to boot otherwise, UNLESS you set ALLOW_UNSAFE_LOCAL_KMS=1
# (solo-dev escape hatch — see below).
NETWORK_MODE=mainnet

# Solo-dev escape hatch. Set ONLY when you understand the risk:
# with this flag, mainnet wallet keys are encrypted with a key derived from
# JWT_SECRET. If JWT_SECRET ever leaks, every wallet on this server is
# decryptable. NEVER set this in production. Throwaway / test wallets only.
# ALLOW_UNSAFE_LOCAL_KMS=1

# --- Database ---
DATABASE_URL=postgresql://qwai:qwai@localhost:5432/qwai
REDIS_URL=redis://localhost:6379

# --- Auth ---
JWT_SECRET=replace-me-32-bytes-min
JWT_EXPIRES_IN=15m
REFRESH_EXPIRES_IN=7d

# --- AWS KMS (envelope encryption for wallet keys) ---
AWS_REGION=us-east-1
AWS_KMS_KEY_ID=alias/qwai-wallet
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- LLM ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-4-6
LLM_TIMEOUT_MS=30000

# --- Market Data ---
COINGECKO_API_KEY=
BIRDEYE_API_KEY=

# --- Token Intel ---
GOPLUS_API_KEY=
RUGCHECK_API_KEY=

# --- Chains ---
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
JUPITER_API_BASE=https://lite-api.jup.ag/swap/v1
JITO_BUNDLE_URL=https://mainnet.block-engine.jito.wtf
ETH_RPC_URL=
ARBITRUM_RPC_URL=
BASE_RPC_URL=
ONEINCH_API_KEY=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=
# gramjs userbot — get both from https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# --- CEX (per-user keys are encrypted in DB; these are platform-level fallbacks) ---

# --- Observability ---
DATADOG_API_KEY=
SENTRY_DSN=

# --- Web ---
NEXT_PUBLIC_API_BASE=http://localhost:4400
NEXT_PUBLIC_WS_BASE=ws://localhost:4400
