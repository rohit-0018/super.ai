dedupe-peer-dependents=true
node-linker=hoisted
public-hoist-pattern[]=*prisma*
public-hoist-pattern[]=@prisma/*
# Keep CI/Render builds from failing on transitive peer mismatches.
strict-peer-dependencies=false
auto-install-peers=true
# Don't let a CI network blip kill a deploy — retry transient tarball fetches.
fetch-retries=5
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=60000
