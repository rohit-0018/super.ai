# JWT Configuration
JWT_PUBLIC_KEY_PATH=./keys/jwt-public.pem
JWT_PRIVATE_KEY_PATH=./keys/jwt-private.pem
JWT_ACCESS_TOKEN_EXPIRY=900
JWT_REFRESH_TOKEN_EXPIRY=86400

# MFA Configuration
MFA_TOTP_ISSUER=SuperAI-Trading
MFA_STEP_UP_RISK_LEVEL=HIGH

# Device Trust
DEVICE_TRUST_SCORE_THRESHOLD=50
DEVICE_TRUST_INCREMENT=10

# Market Data
MARKET_DATA_STALENESS_MS=5000
FEED_CONSENSUS_DIVERGENCE_PERCENT=2.0
ANOMALY_STD_DEV_MULTIPLIER=3.0
ANOMALY_WINDOW_SIZE=100

# Injection Detection
INJECTION_DETECTION_THRESHOLD=0.6

# PII Scrubbing (JSON array of regex strings)
PII_SCRUBBING_PATTERNS=[]

# Trading Universe
APPROVED_TRADING_UNIVERSE=["BTC-USD","ETH-USD","SOL-USD"]

# Position Limits (JSON record: instrument -> max quantity)
POSITION_LIMITS_PER_INSTRUMENT={"BTC-USD":10,"ETH-USD":100,"SOL-USD":1000}

# Portfolio Limits
PORTFOLIO_NOTIONAL_LIMIT=1000000
SESSION_DRAWDOWN_KILL_SWITCH_PERCENT=10

# Circuit Breakers
VELOCITY_CB_ORDER_COUNT=50
VELOCITY_CB_WINDOW_SECONDS=60
ERROR_RATE_CB_CONSECUTIVE_REJECTIONS=10

# Trading Hours (JSON record: market -> {open, close} in UTC HH:MM)
TRADING_HOURS={"DEFAULT":{"open":"00:00","close":"23:59"}}

# Confirmation
HIGH_VALUE_CONFIRMATION_THRESHOLD=100000

# Compliance
WASH_TRADE_DETECTION_WINDOW_MS=300000
LAYERING_DETECTION_WINDOW_MS=60000
LAYERING_CANCEL_RATIO_THRESHOLD=0.8

# Rate Limits
RATE_LIMIT_USER_REQUESTS=100
RATE_LIMIT_USER_WINDOW_MS=60000
RATE_LIMIT_STRATEGY_REQUESTS=50
RATE_LIMIT_STRATEGY_WINDOW_MS=60000
RATE_LIMIT_INSTRUMENT_REQUESTS=200
RATE_LIMIT_INSTRUMENT_WINDOW_MS=60000
RATE_LIMIT_EXCHANGE_REQUESTS=30
RATE_LIMIT_EXCHANGE_WINDOW_MS=1000

# Redis
REDIS_URL=redis://localhost:6379

# KMS
KMS_KEY_ARN=arn:aws:kms:us-east-1:000000000000:key/placeholder
KMS_PROVIDER=local

# Secrets
SECRETS_ROTATION_POLL_INTERVAL_SECONDS=300

# Dead Man's Switch
DEAD_MAN_SWITCH_HEARTBEAT_TIMEOUT_SECONDS=60

# Audit
AUDIT_LOG_OUTPUT_PATH=./logs/audit.jsonl
HMAC_CHAIN_SECRET=change-me-in-production

# CORS
CORS_ALLOWED_ORIGINS=["http://localhost:3001"]

# Alert Bus
ALERT_WEBHOOK_URLS=[]
ALERT_SLACK_CHANNEL=
ALERT_SLACK_WEBHOOK_URL=

# Feed Signature Public Keys (JSON record: source -> base64 public key)
FEED_SIGNATURE_PUBLIC_KEYS={}

# Encryption
ENCRYPTION_KEY_ID=default-encryption-key

# Signing
SIGNING_PRIVATE_KEY=
SIGNING_PUBLIC_KEY=

# Admin
ADMIN_USER_ID=admin
