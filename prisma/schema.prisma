// QWAI Prisma schema — full data model for W1–W6.
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Chain {
  SOLANA
  EVM
}

enum OrderType {
  MARKET
  LIMIT
  STOP_LOSS
  TAKE_PROFIT
  TRAILING_STOP
  BRACKET
  DCA
}

enum OrderStatus {
  PENDING
  ACTIVE
  FILLED
  CANCELLED
  FAILED
}

enum TradeMode {
  LIVE
  PAPER
}

enum AgentKind {
  DCA
  STOP_LOSS
  COPY_TRADE
  POSITION_MONITOR
  SNIPE
  BRIEFING
  LEARNING
  STRATEGY
}

enum AutonomyLevel {
  MANUAL
  GUIDED
  SEMI_AUTO
  FULL_AUTO
}

enum StrategySource {
  LEARNED
  USER_DEFINED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum ApprovalChannel {
  WEB
  TELEGRAM
}

enum AgentStatus {
  RUNNING
  PAUSED
  KILLED
}

enum AlertSeverity {
  INFO
  WARN
  CRITICAL
}

enum Exchange {
  BINANCE
  BYBIT
  OKX
}

enum RejectCategory {
  TOO_RISKY
  WRONG_TOKEN
  BAD_TIMING
  WRONG_SIZE
  OTHER
}

enum IntentSource {
  CHAT
  REJECTION
  MANUAL
  ONBOARDING
  BACKFILL
}

enum IntentScope {
  BLOCKLIST
  ALLOWLIST
  SIZING
  TIMING
  RISK
  PREFERENCE
}

enum IntentStatus {
  ACTIVE
  PROPOSED
  CONFLICTED
  RETIRED
}

enum ChatChannel {
  WEB
  TELEGRAM
  API
}

enum ChatRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

enum NoteCategory {
  PREFERENCE
  CONTEXT
  AVOIDANCE
  GOAL
  TRADING_STYLE
  OTHER
}

enum NoteStatus {
  ACTIVE
  RETIRED
}

model User {
  id              String  @id @default(cuid())
  email           String? @unique
  primaryWallet   String? @unique
  telegramChatId  String? @unique
  phone           String? @unique
  riskProfile     Json?
  emotionalState    Json?
  notificationPrefs Json?
  paperMode         Boolean @default(false)
  // Public leaderboard privacy controls. Default OFF — users must explicitly
  // opt in. The handle is generated once per user and stored stably so the
  // public surface never reveals the cuid even by prefix.
  leaderboardOptIn  Boolean @default(false)
  leaderboardHandle String? @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  wallets         Wallet[]
  sessions        Session[]
  messages        ConversationMessage[]
  tradingDna      TradingDna?
  orders          Order[]
  trades          Trade[]
  agents          Agent[]
  alerts          AlertEvent[]
  priceAlerts     PriceAlert[]
  audit           AuditLog[]
  guardrails      GuardrailConfig?
  cexConnections  CexConnection[]
  paperBalances   PaperBalance[]
  learningConfig  LearningConfig?
  strategies      UserStrategy[]
  approvalRequests ApprovalRequest[]
  intentRules      UserIntentRule[]
  conversations    Conversation[]
  chatMessages     ChatMessage[]
  notes            UserNote[]
  episodes         TradeEpisode[]
  convictionWeights UserConvictionWeights?
  convictionHistory ConvictionWeightsHistory[]
  snipeConfig         SnipeConfig?
  snipeTrades         SnipeTrade[]
  snipeGroupOverrides SnipeGroupOverride[]
  tgUserSession       TgUserSession?
  intelSnapshots      IntelSnapshot[]
  autoPortfolio       AutoPortfolio?
  autoPositions       AutoPosition[]
  autoTrades          AutoTrade[]
}

model Wallet {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  chain         Chain
  address       String
  encryptedKey  String    // KMS envelope ciphertext (base64)
  encryptedDek  String    // wrapped data key (base64)
  label         String?
  isPrimary     Boolean   @default(false)
  isImported    Boolean   @default(false)  // true = user-supplied key, not qwai-generated
  backedUpAt    DateTime?                  // null = user has never confirmed a key backup
  createdAt     DateTime  @default(now())

  @@unique([userId, address])
  @@index([userId])
}

model Session {
  id           String  @id @default(cuid())
  userId       String
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshHash  String
  nonce        String?
  ip           String?
  userAgent    String?
  lastSeen     DateTime @default(now())
  expiresAt    DateTime
  @@index([userId])
}

model ConversationMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   // "user" | "assistant" | "system"
  content   String
  channel   String   // "web" | "telegram"
  meta      Json?
  createdAt DateTime @default(now())
  @@index([userId, createdAt])
}

model TradingDna {
  userId            String  @id
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  winRate           Float   @default(0)
  avgHoldMinutes    Float   @default(0)
  riskScore         Float   @default(5)
  totalTrades       Int     @default(0)
  behavioralSignals Json?
  preferences       Json?
  updatedAt         DateTime @updatedAt
}

model TokenIntel {
  id              String    @id @default(cuid())
  chain           Chain
  address         String
  symbol          String?
  name            String?
  securityScore   Float?
  convictionScore Float?
  holderData      Json?
  securityFlags   Json?
  sentiment       Json?
  priceUsd        Float?
  updatedAt       DateTime  @updatedAt

  // ── Token intelligence layer ──────────────────────────────────────────
  aiScore         Int?
  aiVerdict       String?
  aiSummary       String?
  aiReasoning     Json?     // full AiReasoning object
  killTriggered   Boolean   @default(false)
  killReason      String?
  holderMetrics   Json?
  socialData      Json?
  smartMoneyData  Json?
  fullReport      Json?     // full TokenAnalysisReport for cache restore
  aiAnalyzedAt    DateTime? // when the intelligence layer last ran

  @@unique([chain, address])
}

model Order {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  walletId  String
  type      OrderType
  status    OrderStatus @default(PENDING)
  chain     Chain
  tokenIn   String
  tokenOut  String
  amountIn  String      // bigint as string
  params    Json
  txHash         String?
  pendingTxHash  String?  // set after broadcast, cleared on confirmation — used for crash-recovery polling
  traceId        String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  trades         Trade[]
  @@index([userId, status])
  @@index([traceId])
  @@index([status, pendingTxHash])
}

model Trade {
  id         String        @id @default(cuid())
  orderId    String?
  order      Order?        @relation(fields: [orderId], references: [id])
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  strategyId String?
  strategy   UserStrategy? @relation(fields: [strategyId], references: [id], onDelete: SetNull)
  side       String        // "buy" | "sell"
  chain      Chain
  tokenIn    String
  tokenOut   String
  amountIn   String
  amountOut  String
  priceUsd   Float?
  pnlUsd     Float?
  mode       TradeMode     @default(LIVE)
  txHash     String?
  traceId    String?
  createdAt  DateTime      @default(now())
  episode    TradeEpisode?
  convictionBreakdown Json?
  convictionVersion   Int?
  // ── Exit engine fields ────────────────────────────────────────────────────
  entryMcapUsd          Float?    // mcap at buy time (for tier multiplier)
  highestMcapSeen       Float?    // peak mcap observed since entry (trailing stop anchor)
  lastSignificantMoveAt DateTime? // last time mcap moved >10% (time-stop detection)
  tiersExecuted         Json?     // e.g. [0, 1] — which take-profit tiers have fired
  exitReason            String?   // 'tier_0'|'tier_1'|'tier_2'|'trailing_stop'|'time_stop'|'thesis_break'|'manual'
  exitAt                DateTime?
  realizedPnl           Float?    // USD profit/loss realised at exit
  holdDurationSec       Int?      // seconds from buy to full exit
  @@index([userId, createdAt])
  @@index([userId, strategyId])
  @@index([traceId])
  @@index([exitAt])               // exit engine scans open trades efficiently
}

// L5 — per-user ConvictionEngine weight personalization. Sum should stay at
// 1.0 at all times; service layer enforces + clamps. Learner updates every
// 6h (or at milestone trade counts) using gradient steps on factor edges
// derived from winner/loser trades.
model UserConvictionWeights {
  userId         String    @id
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  security       Float     @default(0.30)
  holders        Float     @default(0.20)
  liquidity      Float     @default(0.15)
  sentiment      Float     @default(0.20)
  momentum       Float     @default(0.15)
  version        Int       @default(1)
  sampleCount    Int       @default(0)
  manualOverride Boolean   @default(false)
  learnedAt      DateTime?
  updatedAt      DateTime  @updatedAt
}

model ConvictionWeightsHistory {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  version     Int
  security    Float
  holders     Float
  liquidity   Float
  sentiment   Float
  momentum    Float
  sampleCount Int
  reason      String
  createdAt   DateTime @default(now())
  @@index([userId, createdAt])
  @@unique([userId, version])
}

// L2 — episodic memory. One row per decision the agent participates in
// (executed, approval-pending, or blocked-candidate). `embedding` is a
// pgvector(1536) column — Prisma reads/writes the embedding only via
// $queryRawUnsafe / $executeRawUnsafe because `Unsupported(...)` columns
// are opaque to the typed client. Outcome columns filled in later by the
// episode-outcome worker once 1h / 24h have elapsed.
model TradeEpisode {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tradeId         String?   @unique
  trade           Trade?    @relation(fields: [tradeId], references: [id], onDelete: SetNull)
  chain           Chain
  token           String
  side            String
  kind            String    // EXECUTED | PAPER | APPROVED | REJECTED
  decisionContext Json
  rationale       String
  outcome1h       Json?
  outcome24h      Json?
  embedding       Unsupported("vector(1536)")?
  createdAt       DateTime  @default(now())
  @@index([userId, createdAt])
  @@index([userId, chain, token])
}

model Agent {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      AgentKind
  status    AgentStatus @default(RUNNING)
  params    Json
  lastRunAt DateTime?
  createdAt DateTime    @default(now())
  @@index([userId, status])
}

model AlertEvent {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind        String
  severity    AlertSeverity @default(INFO)
  payload     Json
  deliveredAt DateTime?
  readAt      DateTime?
  traceId     String?
  createdAt   DateTime      @default(now())
  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model PriceAlert {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String
  chain     Chain
  targetUsd Float
  direction String  @default("below") // "above" | "below"
  fired     Boolean @default(false)
  createdAt DateTime @default(now())
  @@index([userId, fired])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  target    String?
  payload   Json?
  ip        String?
  traceId   String?
  createdAt DateTime @default(now())
  @@index([userId, createdAt])
}

model GuardrailConfig {
  userId         String  @id
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  perTradeUsd    Float   @default(500)
  dailyUsd       Float   @default(2000)
  maxSlippageBps Int     @default(150)
  whitelist      String[]
  blacklist      String[]
  killSwitch     Boolean @default(false)
  updatedAt      DateTime @updatedAt
}

model CexConnection {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exchange        Exchange
  encryptedApiKey String
  encryptedSecret String
  encryptedDek    String
  readOnly        Boolean  @default(true)
  createdAt       DateTime @default(now())
  @@unique([userId, exchange])
}

model PaperBalance {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  token   String
  amount  String  // bigint string
  @@unique([userId, token])
}

// Progressive learning system — per-user switches that gate autonomous behavior.
// Defaults are deliberately safe: learning off, autonomy MANUAL, approval required.
model LearningConfig {
  userId              String          @id
  user                User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  enabled             Boolean         @default(false)
  autonomyLevel       AutonomyLevel   @default(MANUAL)
  maxTradeUsd         Float           @default(100)
  dailyLimit          Int             @default(3)
  dailyUsedCount      Int             @default(0)
  dailyResetAt        DateTime?
  approvalRequired    Boolean         @default(true)
  approvalTimeoutMin  Int             @default(5)
  approvalChannels    ApprovalChannel[]
  onTimeout           String          @default("reject") // "reject" | "execute"
  chatMemoryEnabled   Boolean         @default(true)
  noteExtractionEnabled Boolean       @default(true)
  updatedAt           DateTime        @updatedAt
}

model UserStrategy {
  id             String               @id @default(cuid())
  userId         String
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  source         StrategySource
  definition     Json                 // { prompt?: string, trigger?: {...}, notes?: string }
  enabled        Boolean              @default(false)
  score          Float?               // 0..1, grounded composite (Sharpe + winRate + acceptRate + LLM). 0..10 pre-L3.
  scoreBreakdown Json?                // { sharpeNorm, winRate, acceptRate, llmQualitative, sampleCount, flags[] }
  lastRationale  String?
  lastScoredAt   DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  approvals      ApprovalRequest[]
  trades         Trade[]
  performance    StrategyPerformance?
  @@index([userId, enabled])
}

// Rolling performance aggregates per strategy, recomputed every 10 min by
// strategy-performance.worker from attributed trades + approval outcomes.
// `sampleCount` is the 30-day trade count; all-time is separate. Nullable
// `approvalAcceptRate` when fewer than 3 approvals in the window.
model StrategyPerformance {
  strategyId         String       @id
  strategy           UserStrategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  userId             String
  sampleCount        Int          @default(0)
  sampleCountAllTime Int          @default(0)
  wins               Int          @default(0)
  losses             Int          @default(0)
  totalPnlUsd        Float        @default(0)
  totalPnlUsdAllTime Float        @default(0)
  avgPnlUsd          Float        @default(0)
  stdevPnlUsd        Float        @default(0)
  maxDrawdownUsd     Float        @default(0)
  avgHoldMinutes     Float        @default(0)
  approvalsAccepted  Int          @default(0)
  approvalsRejected  Int          @default(0)
  approvalAcceptRate Float?
  lastTradeAt        DateTime?
  lastComputedAt     DateTime     @default(now())
  @@index([userId])
}

model ApprovalRequest {
  id             String           @id @default(cuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  strategyId     String?
  strategy       UserStrategy?    @relation(fields: [strategyId], references: [id], onDelete: SetNull)
  agentId        String?
  tradeIntent    Json             // { chain, tokenIn, tokenOut, amountIn, side, reason }
  status         ApprovalStatus   @default(PENDING)
  expiresAt      DateTime
  respondedAt    DateTime?
  respondedVia   ApprovalChannel?
  rejectReason   String?
  rejectCategory RejectCategory?
  traceId        String?
  createdAt      DateTime         @default(now())
  @@index([userId, status])
  @@index([status, expiresAt])
}

// L6 — conversational long-term memory. New Conversation/ChatMessage pair
// replaces flat ConversationMessage usage. UserNote stores durable facts
// extracted by the note-extractor after each summary.
model Conversation {
  id                  String        @id @default(cuid())
  userId              String
  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel             ChatChannel
  title               String?
  summary             String?
  summarizedThroughId String?
  lastMessageAt       DateTime      @default(now())
  messageCount        Int           @default(0)
  approxTokenCount    Int           @default(0)
  createdAt           DateTime      @default(now())
  closedAt            DateTime?
  messages            ChatMessage[]
  @@index([userId, lastMessageAt])
  @@index([userId, channel, closedAt])
}

model ChatMessage {
  id             String        @id @default(cuid())
  conversationId String
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           ChatRole
  content        String
  toolCalls      Json?
  toolResults    Json?
  meta           Json?
  tokensIn       Int?
  tokensOut      Int?
  createdAt      DateTime      @default(now())
  @@index([userId, createdAt])
  @@index([conversationId, createdAt])
}

model UserNote {
  id                    String        @id @default(cuid())
  userId                String
  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  category              NoteCategory
  content               String
  sourceConversationIds String[]
  confidence            Float         @default(0.7)
  confirmCount          Int           @default(1)
  lastConfirmedAt       DateTime      @default(now())
  status                NoteStatus    @default(ACTIVE)
  retiredAt             DateTime?
  retiredReason         String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  @@index([userId, status, category])
  @@index([userId, lastConfirmedAt])
}

// ── Sniper ──

enum SellMode {
  TRIGGER      // fast path — same execution as buy
  INTELLIGENT  // routes through AI analysis first
}

model SnipeConfig {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  enabled        Boolean  @default(false)
  chain          Chain    @default(SOLANA)
  walletId       String
  buyAmountRaw   String   @default("100000000")   // lamports (0.1 SOL) or wei
  maxSlippageBps Int      @default(5000)           // 50 % for sniping
  groupIds       String[]                           // Telegram chat IDs to monitor (numeric strings)
  skipSafety     Boolean  @default(true)            // skip rug-check for raw speed
  dedupeWindowMs Int      @default(30000)           // ignore same address within this window
  minLiqUsd      Float    @default(0)
  notifyOnBuy    Boolean  @default(true)            // send Telegram confirmation after each buy
  matchPattern   String?                            // optional regex/keyword; message must match before CA extraction
  sessionExpiresAt DateTime?                        // hot-session expiry (null = no active session)

  // Sell config
  sellEnabled       Boolean   @default(true)
  sellMode          SellMode  @default(TRIGGER)
  takeProfitPct     Float?                      // e.g. 100.0 = sell at 2× entry
  stopLossPct       Float?                      // e.g. -25.0 = sell if down 25%
  trailingStopPct   Float?                      // e.g. 20.0 = sell if 20% below peak
  exitAfterMs       Int?                        // auto-exit after N ms (e.g. 1200000 = 20 min)
  partialExitPct    Float?                      // if set, sell this % at takeProfitPct, trail the rest

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([enabled])
}

model TgUserSession {
  id               String    @id @default(cuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  phoneNumber      String
  encryptedSession String    // gramjs StringSession ciphertext (KMS envelope)
  encryptedDek     String    // wrapped DEK
  isActive         Boolean   @default(true)
  lastConnectedAt  DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model SnipeTrade {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chain     Chain
  mint      String
  amountRaw String
  txHash    String?
  outAmount String?
  groupId   String
  sourceMsg String?  @db.Text
  status    String   @default("broadcast")  // broadcast | confirmed | failed
  errorMsg  String?  @db.Text              // error reason when status=failed
  attempts  Int      @default(1)           // total broadcast attempts including slippage retries

  // Sell tracking
  sellTxHash    String?
  sellStatus    String?                         // pending | broadcast | confirmed | failed | skip
  sellReason    String?                         // take_profit | stop_loss | trailing_stop | time_exit | manual | intelligent
  sellAttempts  Int      @default(0)            // total sell broadcast attempts (for retry limiting)
  peakPriceMul  Float?                          // highest price multiple seen (for trailing stop)
  sellCheckedAt DateTime?                       // last time sell conditions were evaluated

  // Snapshot at fill time — frozen historical context for accurate P&L and
  // "mcap at buy" rendering. All optional: best-effort, never blocks the buy.
  priceAtBuyUsd     Float?                      // per-token USD price at fill
  mcapAtBuyUsd      Float?                      // token market cap at fill (USD)
  liquidityAtBuyUsd Float?                      // pool liquidity at fill (USD)
  solPriceAtBuyUsd  Float?                      // SOL/USD at fill (for cost-basis math)

  // Realized exit snapshot — set when sell is confirmed.
  proceedsSolAtSell Float?                      // SOL received at sell
  proceedsUsdAtSell Float?                      // SOL × SOL/USD at sell time
  pnlUsdRealized    Float?                      // proceeds − cost basis (USD)
  pnlPctRealized    Float?                      // realized P&L %

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([mint, createdAt])
}

// Per-Telegram-group buy/sell overrides. null fields inherit from SnipeConfig.
model SnipeGroupOverride {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupId         String                        // normalized positive Telegram chat ID
  groupTitle      String    @default("")
  enabled         Boolean   @default(true)

  // null = inherit global
  buyAmountRaw    String?
  maxSlippageBps  Int?
  sellMode        SellMode?
  takeProfitPct   Float?
  stopLossPct     Float?
  trailingStopPct Float?
  exitAfterMs     Int?
  matchPattern    String?  // per-group match filter (overrides global SnipeConfig.matchPattern)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([userId, groupId])
  @@index([userId])
}

// L4 — declarative intent memory. Natural-language rules extracted from chat
// or rejections, stored with both human text and a machine DSL. Enforced by
// IntentRuleEnforcer in the autonomous-trader before guardrails.
model UserIntentRule {
  id                String        @id @default(cuid())
  userId            String
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  text              String        // original user phrasing
  rule              Json          // structured DSL — see intent-rule.dsl.ts
  source            IntentSource
  scope             IntentScope
  status            IntentStatus  @default(ACTIVE)
  priority          Int           @default(50)
  confidence        Float         @default(1.0)
  lastAppliedAt     DateTime?
  retiredReason     String?
  sourceApprovalId  String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  @@index([userId, status, scope])
  @@index([userId, lastAppliedAt])
}

model PhoneOtp {
  id        String   @id @default(cuid())
  phone     String
  otpHash   String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  @@index([phone])
}

// ── Intel Track Record ────────────────────────────────────────────────────────
// Frozen snapshots of every meaningful token call the bot has made. Used for
// the public track record / "if you'd entered when we said, you'd be up X%"
// marketing surface. The IntelSnapshot row is immutable for the "what we
// said" frozen fields; aggregates (currentMcapUsd, pumpedHigh, etc) are
// updated by the IntelRescanWorker. IntelRescan is an append-only ticks
// table for the timeline / sparkline.
model IntelSnapshot {
  id              String   @id @default(cuid())
  userId          String?              // null = system-captured (hot tokens scan)
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  chain           Chain
  address         String
  symbol          String?
  name            String?
  capturedAt      DateTime @default(now())
  source          String                // 'hot_tokens_scan' | 'manual_scan' | 'telegram_scan' | 'snipe'
  profileKey      String?               // e.g. 'meme_hunter' for hot tokens
  // Frozen-at-capture market state
  priceUsdAtCapture     Float
  marketCapUsdAtCapture Float?
  liquidityUsdAtCapture Float?
  volume24hAtCapture    Float?
  // What we said and why — full TokenAnalysisReport JSON
  reportJson      Json
  aiScore         Int?
  aiVerdict       String?
  aiSummary       String?
  killTriggered   Boolean  @default(false)
  // Mutable aggregates (updated by IntelRescanWorker)
  lastRescannedAt   DateTime?
  currentPriceUsd   Float?
  currentMcapUsd    Float?
  currentLiquidity  Float?
  pumpedHigh        Float?              // highest mcap observed since capture
  pumpedHighAt      DateTime?
  drawdownLow       Float?
  drawdownLowAt     DateTime?
  rescanCount       Int      @default(0)
  reappearedAt      DateTime?
  reappearedSource  String?
  // active | retired | rugged | graduated
  status            String   @default("active")
  // Pre-computed sparkline (last N mcap-band values, uint16-equivalent ints)
  sparkline         Json?

  rescans           IntelRescan[]

  @@unique([chain, address])
  @@index([status, capturedAt])
  @@index([pumpedHigh])
  @@index([source, capturedAt])
}

model IntelRescan {
  id            String   @id @default(cuid())
  snapshotId    String
  snapshot      IntelSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  ts            DateTime @default(now())
  priceUsd      Float
  marketCapUsd  Float?
  liquidityUsd  Float?
  volume24hUsd  Float?
  aiVerdict     String?
  aiScore       Int?
  @@index([snapshotId, ts])
}

// ── Verdict History ───────────────────────────────────────────────────────────
// One row per completed AI analysis, written by SignalPipelineService.
// Survives restarts (unlike the in-memory results map) and powers:
//   • startup hydration — last verdict per token loaded immediately
//   • exit engine thesis-break — score degradation detected across rows
//   • performance analytics — win-rate per score tier, source, profile
model VerdictHistory {
  id             String   @id @default(cuid())
  address        String
  chain          Chain    @default(SOLANA)
  symbol         String?
  name           String?
  analyzedAt     DateTime @default(now())
  aiScore        Int
  aiVerdict      String
  priceUsd       Float
  marketCapUsd   Float?
  t1Pct          Float?
  t2Pct          Float?
  stopLossPct    Float?
  riskReward     Float?
  aiSummary      String?
  bullishSignals Json     @default("[]")
  riskFactors    Json     @default("[]")
  // 'scanner_auto' | 'page_load_batch' | 'manual_request'
  source         String   @default("scanner_auto")
  profileKey     String?
  latencyMs      Int?

  @@index([address, analyzedAt])
  @@index([aiScore, analyzedAt])
  @@index([analyzedAt])
}

// ── Provider Rate-Limit Registry ─────────────────────────────────────────────
// Static config per external API provider. Dynamic state (counters, cooldowns)
// lives in Redis (key prefix rl:). This table is the source-of-truth for limits
// and is seeded once; ops can edit rows to tune limits without code deploys.
model ProviderConfig {
  id            String   @id @default(cuid())
  key           String   @unique  // e.g. "dexscreener", "goplus"
  displayName   String
  dataGroup     String   // e.g. "MARKET_DATA", "SAFETY_SOL", "BUNDLE_SOL"
  priority      Int      @default(100)  // lower = higher priority in fallback chain
  reqsPerWindow Int      @default(60)   // max requests per windowSec
  windowSec     Int      @default(60)   // sliding window duration in seconds
  cooldownSec   Int      @default(120)  // back-off duration after 429/rate-limit
  enabled       Boolean  @default(true)
  requiresKey   String?  // env var that must be set for this provider to activate
  baseUrl       String?  // informational
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([dataGroup, priority])
}

// ── Auto-Trade Engine ───────────────────────────────────────────────────────
// One engine for both PAPER (fake $, default) and LIVE (real $, gated) auto-
// trading. Mode is User.paperMode; live wiring deferred behind env gate.
// See memory: project_auto_trade_engine.md
//
// Models renamed Paper* → Auto* but DB tables stay as Paper* via @@map so we
// skip the migration. Cleanup in a future deliberate pass.
model AutoPortfolio {
  userId               String   @id
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  startingBalanceUsd   Float    @default(100000)
  currentBalanceUsd    Float    @default(100000)
  realizedPnlUsd       Float    @default(0)
  totalTrades          Int      @default(0)
  winCount             Int      @default(0)
  lossCount            Int      @default(0)
  // Auto-mode settings — picker reads these every tick.
  autoEnabled          Boolean  @default(false)
  autoProfile          String   @default("meme_hunter")
  autoMinScore         Int      @default(70)
  positionSizeUsd      Float    @default(200)
  maxConcurrent        Int      @default(10)
  cooldownMinutes      Int      @default(15)
  // Per-position exit overrides (null = use profile defaults).
  takeProfit1Pct       Float?
  takeProfit2Pct       Float?
  stopLossPct          Float?
  maxHoldMinutes       Int?
  resetAt              DateTime @default(now())
  lastTradeAt          DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("PaperPortfolio")
}

// Open virtual position. Deleted when closed; an AutoTrade row is created
// in the same transaction. Unique on (userId, tokenAddress) so concurrent
// picker ticks can't open duplicates.
model AutoPosition {
  id                   String   @id @default(cuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenAddress         String
  symbol               String?
  name                 String?
  chain                Chain    @default(SOLANA)
  profileKey           String   @default("meme_hunter")
  source               String   @default("auto_picker") // auto_picker | manual
  openedAt             DateTime @default(now())
  entryPriceUsd        Float
  sizeUsd              Float
  tokenAmount          Float
  takeProfit1PriceUsd  Float
  takeProfit2PriceUsd  Float
  stopLossPriceUsd     Float
  maxHoldMs            Int      @default(14400000) // 4h default
  currentPriceUsd      Float
  unrealizedPnlUsd     Float    @default(0)
  unrealizedPnlPct     Float    @default(0)
  scoreAtEntry         Int
  verdictAtEntry       String
  scoreBreakdownJson   Json?
  updatedAt            DateTime @updatedAt

  @@unique([userId, tokenAddress])
  @@index([userId, openedAt])
  @@map("PaperPosition")
}

// Closed-trade history. Append-only — every exit lands here so users can
// audit "what would the bot have done last week".
enum AutoExitReason {
  TP1
  TP2
  STOP_LOSS
  MAX_HOLD
  MANUAL
  RUG

  @@map("PaperExitReason")
}

model AutoTrade {
  id                   String          @id @default(cuid())
  userId               String
  user                 User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenAddress         String
  symbol               String?
  name                 String?
  chain                Chain           @default(SOLANA)
  profileKey           String
  source               String
  openedAt             DateTime
  closedAt             DateTime        @default(now())
  holdMs               Int
  entryPriceUsd        Float
  exitPriceUsd         Float
  sizeUsd              Float
  tokenAmount          Float
  pnlUsd               Float
  pnlPct               Float
  exitReason           AutoExitReason
  scoreAtEntry         Int
  verdictAtEntry       String
  scoreBreakdownJson   Json?

  @@index([userId, closedAt])
  @@index([userId, exitReason])
  @@map("PaperTrade")
}
