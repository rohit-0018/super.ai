# --- Core ---
NODE_ENV=development
PORT=4000
WEB_PORT=3000

# --- Database ---
DATABASE_URL=postgresql://qwai:qwai@localhost:5432/qwai
REDIS_URL=redis://localhost:6379

# --- Auth ---
JWT_SECRET=replace-me-32-bytes-min
JWT_EXPIRES_IN=15m
REFRESH_EXPIRES_IN=7d

# --- AWS KMS (envelope encryption for wallet keys) ---
AWS_REGION=us-east-1
AWS_KMS_KEY_ID=alias/qwai-wallet
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- LLM ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-4-6
LLM_TIMEOUT_MS=30000

# --- Market Data ---
COINGECKO_API_KEY=
BIRDEYE_API_KEY=

# --- Token Intel ---
GOPLUS_API_KEY=
RUGCHECK_API_KEY=

# --- Chains ---
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
JUPITER_API_BASE=https://quote-api.jup.ag/v6
JITO_BUNDLE_URL=https://mainnet.block-engine.jito.wtf
ETH_RPC_URL=
ARBITRUM_RPC_URL=
BASE_RPC_URL=
ONEINCH_API_KEY=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=

# --- CEX (per-user keys are encrypted in DB; these are platform-level fallbacks) ---

# --- Observability ---
DATADOG_API_KEY=
SENTRY_DSN=

# --- Web ---
NEXT_PUBLIC_API_BASE=http://localhost:4000
NEXT_PUBLIC_WS_BASE=ws://localhost:4000
